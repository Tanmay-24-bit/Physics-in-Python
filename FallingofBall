import numpy as np 
import sympy as smp
import matplotlib.pyplot as plt

g = 9.8
a = -g
t = smp.symbols('t')
u = smp.symbols('u')
v = smp.integrate(a, t) + u
s = smp.integrate(v, t) 

s_value = smp.lambdify((t, u), s)

t_points = np.linspace(0, 10, 50)
s_points = s_value(t_points, 20)

plt.figure(figsize = (11, 7))
plt.plot(t_points, s_points, 'o--', color = 'red', ms = 3, lw = 1.2)
plt.xlabel('Time (in s)')
plt.ylabel('Displacement (in m)')
plt.minorticks_on()
plt.locator_params(axis = 'x', nbins = 15)
plt.locator_params(axis = 'y', nbins = 15)
plt.grid(which = 'major', color = 'black', lw = 1.0)
plt.grid(which = 'minor', color = 'gray', lw = 0.7, ls = ":")
plt.savefig('fall.png')
plt.show()
